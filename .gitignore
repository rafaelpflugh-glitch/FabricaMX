# Ambiente virtual e cache Python
.venv/
__pycache__/
*.py[cod]
*$py.class

# Arquivos temporários, vídeos gerados e B-Roll pesados locais
temp/*
!temp/.gitkeep
output/*
!output/.gitkeep
nichos/*/output/*
!nichos/*/output/.gitkeep
nichos/*/assets/broll/*.mp4
nichos/*/assets/broll/*.mov
nichos/*/assets/broll/*.mkv
nichos/*/assets/broll/*.webm
nichos/*/assets/broll/scene_index.json

# Segredos / chaves de API locais (NUNCA subir pro GitHub!)
secrets.json
.env

# Sistema operacional / IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
